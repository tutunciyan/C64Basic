10 REM DISK FILES: WRITE A SEQUENTIAL FILE, READ IT BACK, THEN SCRATCH IT
20 OPEN 1,8,2,"DEMODATA,S,W"
30 FOR I=1 TO 5:PRINT#1,I*I:NEXT
40 CLOSE 1
50 OPEN 1,8,2,"DEMODATA"
60 FOR I=1 TO 5:INPUT#1,A:PRINT A;:NEXT
70 CLOSE 1:PRINT
80 OPEN 15,8,15,"S:DEMODATA"
90 INPUT#15,E,E$,T,S:PRINT E;E$;T
100 CLOSE 15
