10 REM SPRITE BOUNCER - BEST IN THE GUI (src/C64Basic.Gui)
20 PRINT CHR$(147);"A BALL BOUNCING OFF THE BORDER"
30 REM DRAW A 24X21 CIRCLE INTO THE SPRITE AT 832
40 FOR R=0 TO 20:FOR B=0 TO 2:V=0
50 FOR K=0 TO 7:C=B*8+K:IF (C-11.5)^2+(R-10)^2<=100 THEN V=V+2^(7-K)
60 NEXT:POKE 832+R*3+B,V:NEXT:NEXT
70 POKE 2040,13:POKE 53287,7:POKE 53269,1
80 X=100:Y=100:DX=3:DY=2
90 FOR T=1 TO 400
100 X=X+DX:Y=Y+DY
110 IF X<24 OR X>320 THEN DX=-DX
120 IF Y<50 OR Y>229 THEN DY=-DY
130 POKE 53264,-(X>255):POKE 53248,X AND 255:POKE 53249,Y
140 NEXT
150 POKE 53269,0
